/* Ben 10 Dancing */
.player-controls .playback-progressbar::before {
    content: '';
    width: 32px;
    height: 32px;
    bottom: calc(100% - 7px);
    right: 10px;
    position: absolute;
    image-rendering: pixelated;
    background-size: 32px 32px;
    background-image: url('https://media.tenor.com/8eLJOzH8uTMAAAAj/ben-10-dance.gif');
}
  }
]
